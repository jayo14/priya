# Priya Application Environment Configuration
APP_NAME=Priya
APP_ENV=development
DEBUG=true

# Backend API Service
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# PostgreSQL Database
# Note: For psycopg 3, SQLAlchemy URL scheme is postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://priya_user:priya_pass@127.0.0.1:5432/priya
TEST_DATABASE_URL=postgresql+psycopg://priya_user:priya_pass@127.0.0.1:5432/priya_test

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Logging & Presentation
LOG_LEVEL=INFO
TIMEZONE=Africa/Lagos

# Telegram Bot Alerts (Phase 7)
# Leave empty for simulated/logged delivery in development
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
